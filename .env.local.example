# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# M-Pesa Daraja
MPESA_CONSUMER_KEY=xxx
MPESA_CONSUMER_SECRET=xxx
MPESA_SHORTCODE=174379
MPESA_PASSKEY=xxx
MPESA_CALLBACK_URL=https://yourapp.vercel.app/api/payments/mpesa/callback

# Trigger.dev
TRIGGER_API_KEY=tr_dev_xxx

# Appointment reminders — SMS via Africa's Talking (Kenya). Customers can opt out per-person.
AT_USERNAME=xxx
AT_API_KEY=atsk_xxx
AT_SENDER_ID=PHARMATRACK
AT_SANDBOX=false

# Appointment reminders — Email via Resend
RESEND_API_KEY=re_xxx
RESEND_FROM=PharmaTrack <noreply@yourdomain.com>

# Appointment reminders — WhatsApp via Meta Cloud API (optional; preferred over
# SMS for customers when set). Business-initiated reminders need an approved
# template whose body is a single {{1}} parameter.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=appointment_reminder
WHATSAPP_LANG=en

# Secret the reminder cron must present. Set the SAME value in Vercel → Project
# → Settings → Environment Variables; Vercel Cron sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`. The cron runs once daily (free tier).
CRON_SECRET=generate-a-long-random-string

# Error tracking (Sentry) — optional; leave blank to disable (no-op).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Subscription billing (Paystack) — optional; leave blank for manual billing.
# Set the webhook URL in the Paystack dashboard to {APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
