# Dependencies
node_modules/
.pnpm-store/

# Next.js
apps/web/.next/
apps/web/out/

# Environment variables — NEVER commit secrets
apps/web/.env.local
apps/web/.env.*.local
.env.local
.env.*.local
# Root .env (contains secrets: DB passwords, BETTER_AUTH_SECRET, API keys)
/.env
# Production env (real secrets — generated, copied to the server)
/.env.production
/.env.prod

# SSH / private keys — NEVER commit (e.g. the EC2 deploy key)
*.pem
*.key
*_rsa
id_*

# Build outputs
dist/
build/
.turbo/

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Local DB backups (pg_dump output)
infra/backups/

# Tauri desktop app
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/dist/

# Offline Edition (ADR-014) — vendored per-target third-party binaries +
# build artifacts; never committed, fetched by
# apps/desktop/scripts/fetch-offline-resources.mjs right before a build.
apps/desktop/src-tauri/resources/
apps/desktop/src-tauri/binaries/
