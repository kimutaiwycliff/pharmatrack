# PharmaTrack env (self-hosted). Copy to .env and fill in. See CLAUDE.md §10.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fuzzy-search strictness (pg_trgm). Lower = more typo-tolerant (more noise),
# higher = stricter. Default 0.3; a request may override with ?threshold= .
# SEARCH_SIMILARITY_THRESHOLD=0.3

# ── SEO / analytics (marketing site; all optional, env-gated) ─────────────────
# Analytics load only when set, and only on the public marketing pages.
# Runtime vars (server-rendered) — edit here + restart the web container, no rebuild.
# GA_ID=G-XXXXXXXXXX                          # Google Analytics 4 Measurement ID
# CF_BEACON_TOKEN=                            # Cloudflare Web Analytics token
# HTML-tag site verification (only needed if NOT using DNS verification):
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=       # Search Console meta tag content
# NEXT_PUBLIC_BING_SITE_VERIFICATION=         # Bing Webmaster meta tag content

# ── Production edge (Caddy) ──────────────────────────────────────────────────
# Domain Caddy serves (production). Set when deploying behind Caddy.
APP_DOMAIN=pharmatrack.co.ke
# TLS mode: leave unset for grey cloud (Let's Encrypt). For Cloudflare orange
# cloud, set CADDYFILE=../Caddyfile.cloudflare and drop the origin cert in
# infra/certs/. See DEPLOYMENT.md §C.4.
# CADDYFILE=../Caddyfile.cloudflare

# ── Database (two roles) ─────────────────────────────────────────────────────
POSTGRES_DB=pharmatrack
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
APP_OWNER_PASSWORD=app_owner
APP_AUTHENTICATED_PASSWORD=app_authenticated
# Used by the app (host ports for local dev; in-compose use postgres:5432):
DATABASE_URL=postgres://app_owner:app_owner@localhost:55432/pharmatrack
DATABASE_AUTHENTICATED_URL=postgres://app_authenticated:app_authenticated@localhost:55432/pharmatrack

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). Authorised redirect URI in Google Cloud console:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile captcha (optional). Site key is public (browser), secret
# is server-only. When unset, captcha is skipped everywhere.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where to email new-signup / new-subscription alerts. Comma-separated. If unset,
# all platform_admin accounts are notified.
PLATFORM_NOTIFY_EMAIL=

# Operator contact shown to tenants (e.g. on the subscription-paused screen).
# Runtime-configurable — change + restart, no rebuild. WhatsApp accepts a Kenyan
# local (0716…) or international (2547…) number. Email falls back to the first
# PLATFORM_NOTIFY_EMAIL if unset.
PLATFORM_CONTACT_EMAIL=
PLATFORM_CONTACT_WHATSAPP=0716522948

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:56379
REDIS_PORT=56379

# ── MinIO (S3) ───────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PRODUCTS=pharmatrack-products

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=no-reply@yourdomain.com

# ── M-Pesa Daraja ────────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/mpesa/callback
MPESA_ENV=sandbox

# ── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Africa's Talking (SMS + WhatsApp) ────────────────────────────────────────
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=

# ── Off-site backups (Cloudflare R2) ─────────────────────────────────────────
# Used by infra/backup.sh (cron) + infra/restore.sh. R2 is off the VM, so backups
# survive a VM loss. See DISASTER_RECOVERY.md.
# Create: Cloudflare → R2 → bucket "pharmatrack-backups" + an API token
# (Object Read & Write). Account ID is in the R2 endpoint URL.
R2_BUCKET=pharmatrack-backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# age PUBLIC key (from `age-keygen`). Encrypts backups before upload — safe on
# the VM (it can only encrypt). Keep the matching PRIVATE key in your password
# manager; it is the ONLY thing that can decrypt a restore.
BACKUP_AGE_RECIPIENT=
# Days to keep DB dumps in R2 (default 14).
BACKUP_RETAIN_DAYS=14
# RESTORE ONLY — path to the age PRIVATE key on the recovery box. Do NOT set this
# on the live VM; provide it only while running infra/restore.sh.
# BACKUP_AGE_KEYFILE=/root/pharmatrack-backup.key

# ── Cron + observability ─────────────────────────────────────────────────────
CRON_SECRET=change-me
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
